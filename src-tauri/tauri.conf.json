{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GIC Booth",
  "version": "0.1.0",
  "identifier": "com.gic.booth",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GIC Booth",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
